# ════════════════════════════════════════════════════════════════
# FITBOT VIDEO PIPELINE — Environment Variables
# Copy to .env and fill in your values
# NEVER commit .env to GitHub
# ════════════════════════════════════════════════════════════════

# ── REQUIRED (both free, no card) ────────────────────────────

# Google Gemini — free at aistudio.google.com → Get API Key
GEMINI_API_KEY=AIzaSy_your_key_here

# Pexels — free at pexels.com/api → Your API Key
# Free: 200 requests/hour, 20,000/month — plenty for 1 video/day
PEXELS_API_KEY=your_pexels_key_here

# ── OPTIONAL SETTINGS ─────────────────────────────────────────
NICHE=fitness and sports
CHANNEL_NAME=Mhed Fitness & Sports
VIDEO_DURATION=45

# TTS voice — run: edge-tts --list-voices | grep en-US
# Options: en-US-GuyNeural, en-US-JennyNeural, en-US-AriaNeural
TTS_VOICE=en-US-GuyNeural

# ── VIDEO RESOLUTION ──────────────────────────────────────────
# 1080p = 1920×1080  Full HD  — YouTube standard (default, recommended)
# 2K    = 2560×1440  QHD      — larger files, slower encode
# 4K    = 3840×2160  UHD      — largest files, matches top creators
VIDEO_RESOLUTION=1080p

# ── PLATFORM POSTING (all optional — skip any platform) ──────

# TikTok
# Get at: developers.tiktok.com → Login Kit + Content Posting API
TIKTOK_ACCESS_TOKEN=

# Instagram (via Meta Graph API)
# Get at: developers.facebook.com → Create App → Instagram Graph API
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# YouTube (OAuth2)
# Get at: console.cloud.google.com → YouTube Data API v3 → OAuth credentials
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Facebook Page
# Get at: developers.facebook.com → Create App → Pages API
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=

# ── VIDEO CDN URL ─────────────────────────────────────────────
# TikTok and Instagram Reels need a PUBLIC URL for your video.
# Easiest option: upload video to Cloudinary free tier (cloudinary.com)
# and paste the URL here. Or use any public file host.
# YouTube and Facebook upload the file directly — no URL needed.
VIDEO_CDN_URL=https://res.cloudinary.com/your-account/video/upload/fitbot.mp4
